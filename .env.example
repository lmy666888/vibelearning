# Backend only: copy to backend/.env (ignored by Git), then choose a compatible model.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend only: frontend/.env.local, empty uses the Vite /api proxy.
VITE_API_BASE_URL=
